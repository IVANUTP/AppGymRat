<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true">

    <!-- LOGO / NOMBRE APP -->
    <TextView
        android:id="@+id/txtLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GYMRAT"
        android:textSize="42sp"
        android:textStyle="bold"
        android:textColor="#FF6B00"
        android:letterSpacing="0.05"
        android:layout_marginTop="70dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- SLOGAN -->
    <TextView
        android:id="@+id/txtSlogan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Entrena, Progresa, Repite."
        android:textSize="16sp"
        android:textColor="#1A1A1A"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/txtLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!--
        ==========================================
        ZONA DE ILUSTRACIONES / "MONITOS"
        ==========================================
        Acá va el contenedor para las imágenes tipo
        las que se ven en la referencia (personas
        haciendo ejercicio, en fila horizontal).

        Sugerencia de estructura para cuando las tengas:

        <LinearLayout
            android:id="@+id/containerIlustraciones"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/txtSlogan"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/ilustracion_1"
                android:scaleType="fitCenter"/>

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/ilustracion_2"
                android:scaleType="fitCenter"/>

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/ilustracion_3"
                android:scaleType="fitCenter"/>

        </LinearLayout>
    -->

    <!-- PLACEHOLDER temporal mientras no están las ilustraciones -->
    <View
        android:id="@+id/placeholderIlustraciones"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@id/txtSlogan"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- BOTON EMPEZAR (Registro) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEmpezar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="EMPEZAR"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:textColor="#FFFFFF"
        app:backgroundTint="#FF6B00"
        app:cornerRadius="18dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/btnYaTengoCuenta"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- BOTON YA TENGO CUENTA (Login) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnYaTengoCuenta"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="YA TENGO UNA CUENTA"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:textColor="#FF6B00"
        app:backgroundTint="#FFF1E5"
        app:cornerRadius="18dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>