<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <!-- VOLVER -->
    <ImageView
        android:id="@+id/btnVolver"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:padding="10dp"
        android:src="@drawable/ic_back"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/volver"
        app:tint="#1A1A1A"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- BARRA DE PROGRESO -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progresoEncuesta"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="20dp"
        android:progress="33"
        app:trackColor="#E8E8E8"
        app:trackCornerRadius="4dp"
        app:indicatorColor="#FF6B00"
        app:layout_constraintTop_toBottomOf="@id/btnVolver"
        app:layout_constraintStart_toEndOf="@id/btnVolver"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/btnVolver"/>

    <!-- ESPACIO MASCOTA (agregar después) -->
    <View
        android:id="@+id/espacioMascota"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginTop="30dp"
        android:layout_marginStart="20dp"
        app:layout_constraintTop_toBottomOf="@id/btnVolver"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- BURBUJA DE CHAT -->
    <TextView
        android:id="@+id/txtMensajeChat"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_chat_bubble"
        android:padding="16dp"
        android:text="¿Cómo te deberíamos llamar?"
        android:textColor="#1A1A1A"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/espacioMascota"
        app:layout_constraintBottom_toBottomOf="@id/espacioMascota"
        app:layout_constraintStart_toEndOf="@id/espacioMascota"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- PREGUNTA -->
    <TextView
        android:id="@+id/txtPregunta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginHorizontal="20dp"
        android:text="¿Cuál es tu nombre?"
        android:textColor="#1A1A1A"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/espacioMascota"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- INPUT -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/inputLayoutNombre"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginHorizontal="20dp"
        app:boxCornerRadiusTopStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusBottomEnd="14dp"
        app:boxStrokeColor="#FF6B00"
        app:hintEnabled="false"
        app:layout_constraintTop_toBottomOf="@id/txtPregunta"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej. Angel"
            android:padding="14dp"
            android:textSize="16sp"
            android:maxLines="1"/>

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="22dp"
        android:text="Puedes cambiar tu nombre más tarde en tu perfil"
        android:textColor="#999999"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/inputLayoutNombre"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- BOTON -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSiguiente"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="30dp"
        android:text="Siguiente"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:enabled="false"
        app:backgroundTint="@color/btn_estado_selector"
        app:cornerRadius="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>