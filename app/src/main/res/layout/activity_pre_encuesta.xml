<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <!-- BOTON VOLVER -->
    <ImageView
        android:id="@+id/btnVolver"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:padding="10dp"
        android:src="@drawable/ic_back"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/volver"
        app:tint="#1A1A1A"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- BURBUJA DE CHAT -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/burbujaChat"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintTop_toBottomOf="@id/btnVolver"
        app:layout_constraintBottom_toTopOf="@id/espacioMascota"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.35"
        app:layout_constraintVertical_chainStyle="packed">

        <TextView
            android:id="@+id/txtMensajeChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_bubble"
            android:padding="22dp"
            android:text="¡Solo tenemos unas pocas preguntas y podemos comenzar!"
            android:textColor="#1A1A1A"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- COLITA DE LA BURBUJA -->
        <View
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="#FFFFFF"
            android:rotation="45"
            app:layout_constraintTop_toBottomOf="@id/txtMensajeChat"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="40dp"
            android:layout_marginTop="-10dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ESPACIO RESERVADO PARA LA MASCOTA (agregar después) -->
    <View
        android:id="@+id/espacioMascota"
        android:layout_width="0dp"
        android:layout_height="220dp"
        app:layout_constraintTop_toBottomOf="@id/burbujaChat"
        app:layout_constraintBottom_toTopOf="@id/btnSuenaBien"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- BOTON CTA -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSuenaBien"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="30dp"
        android:text="¡Suena bien!"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        app:backgroundTint="#FF6B00"
        app:cornerRadius="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>